<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Admin") | ABS Silk Saris</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <aside class="admin-side">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.svg" width="36" height="36" alt="" />
            <span>ABS Admin</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid"></i> Dashboard</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder"></i> Categories</a>
                <a asp-area="Admin" asp-controller="SubCategories" asp-action="Index"><i class="bi bi-diagram-3"></i> Subcategories</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-bag"></i> Products &amp; images</a>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders"></i> Site options</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-box-arrow-up-right"></i> View store</a>
            </nav>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mt-auto p-3">
                @Html.AntiForgeryToken()
                <button class="btn-outline-maroon w-100" type="submit">Sign out @User.Identity.Name</button>
            </form>
        }
    </aside>
    <div class="admin-main">
        @if (TempData["Notice"] is string n)
        {
            <div class="toast-notice">@n</div>
        }
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
