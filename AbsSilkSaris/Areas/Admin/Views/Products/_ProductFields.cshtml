@model Product
@{
    var cats = ViewBag.Categories as List<Category> ?? new();
    var subs = ViewBag.SubCategories as List<SubCategory> ?? new();
}
<div class="row g-3">
    <div class="col-md-8">
        <label>Name</label>
        <input class="form-control mb-3" asp-for="Name" required />
        <label>SKU</label>
        <input class="form-control mb-3" asp-for="Sku" />
        <label>Slug</label>
        <input class="form-control mb-3" asp-for="Slug" />
        <label>Description</label>
        <textarea class="form-control mb-3" asp-for="Description" rows="4"></textarea>
    </div>
    <div class="col-md-4">
        <label>Category</label>
        <select class="form-select mb-3" asp-for="CategoryId" id="CategoryId" required>
            @foreach (var c in cats) { <option value="@c.Id">@c.Name</option> }
        </select>
        <label>Subcategory</label>
        <select class="form-select mb-3" asp-for="SubCategoryId" id="SubCategoryId">
            <option value="0">None</option>
            @foreach (var s in subs) { <option value="@s.Id">@s.Name</option> }
        </select>
        <label>Price</label>
        <input class="form-control mb-3" asp-for="Price" />
        <label>Compare-at price</label>
        <input class="form-control mb-3" asp-for="CompareAtPrice" />
        <label>Colour</label>
        <input class="form-control mb-3" asp-for="Color" />
        <label>Weave</label>
        <input class="form-control mb-3" asp-for="Weave" />
        <label>Occasion</label>
        <input class="form-control mb-3" asp-for="Occasion" />
        <label>Stock</label>
        <input class="form-control mb-3" asp-for="Stock" />
        <div class="form-check"><input type="hidden" name="IsNew" value="false" /><input class="form-check-input" type="checkbox" name="IsNew" value="true" @(Model.IsNew ? "checked" : null) /> <label class="form-check-label">New arrival</label></div>
        <div class="form-check"><input type="hidden" name="IsBestSeller" value="false" /><input class="form-check-input" type="checkbox" name="IsBestSeller" value="true" @(Model.IsBestSeller ? "checked" : null) /> <label class="form-check-label">Best seller</label></div>
        <div class="form-check mb-3"><input type="hidden" name="IsActive" value="false" /><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : null) /> <label class="form-check-label">Active</label></div>
    </div>
</div>
