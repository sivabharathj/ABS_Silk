@model List<SubCategory>
@{
    var cats = ViewBag.Categories as List<Category> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="serif mb-0">Subcategories</h1>
    <a class="btn-gold" asp-action="Create">Add subcategory</a>
</div>
<p class="text-muted">Subcategories sit under a category in the top menu dropdown.</p>
<table class="table align-middle">
    <thead><tr><th>Category</th><th>Subcategory</th><th>Slug</th><th>Menu</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.CategoryName</td>
            <td>@s.Name</td>
            <td>@s.Slug</td>
            <td>@(s.ShowInMenu ? "Yes" : "No")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this subcategory?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@s.Id" />
                    <button class="btn-reset text-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
