@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
    <a class="icon-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" title="Admin">
        <i class="bi bi-speedometer2"></i>
        <span class="d-none d-xl-inline">Admin</span>
    </a>
    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="icon-link btn-reset">Sign out</button>
    </form>
}
else
{
    <a class="icon-link" asp-area="Admin" asp-controller="Account" asp-action="Login" title="Admin login">
        <i class="bi bi-person"></i>
        <span class="d-none d-xl-inline">Admin</span>
    </a>
}
