@using Microsoft.AspNetCore.Identity
@using AbsSilkSaris.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a class="icon-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Account">
        <i class="bi bi-person"></i>
        <span class="d-none d-xl-inline">Account</span>
    </a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="icon-link btn-reset">Sign out</button>
    </form>
}
else
{
    <a class="icon-link" asp-area="Identity" asp-page="/Account/Login">
        <i class="bi bi-person"></i>
        <span class="d-none d-xl-inline">Login</span>
    </a>
    <a class="icon-link d-none d-lg-inline" asp-area="Identity" asp-page="/Account/Register">Register</a>
}
