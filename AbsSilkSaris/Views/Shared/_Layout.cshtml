@inject AbsSilkSaris.Services.SessionCartService Cart
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var store = Config["Store:Name"] ?? "ABS Silk Saris";
    var wa = Config["Store:WhatsApp"] ?? "919876543210";
    var phone = Config["Store:Phone"] ?? "";
    var email = Config["Store:Email"] ?? "";
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? store : $"{title} | {store}";
    var desc = ViewData["MetaDescription"] as string ?? "Authentic Kanchipuram silk sarees for every celebration. Bridal, wedding, pure zari and soft silks woven in Kanchipuram.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@desc" />
    <meta name="theme-color" content="#6b1d2a" />
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@desc" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/images/hero/hero-kanchipuram-saree.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "@store",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "logo": "@($"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.svg")",
      "telephone": "@phone",
      "email": "@email",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "14, Silk Weavers Street",
        "addressLocality": "Kanchipuram",
        "addressRegion": "Tamil Nadu",
        "postalCode": "631501",
        "addressCountry": "IN"
      }
    }
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">
        <div class="container-xl d-flex justify-content-between align-items-center gap-3">
            <span>Complimentary shipping on silks above ₹15,000 · Authenticated zari · Worldwide delivery</span>
            <span class="d-none d-md-inline">Concierge @phone</span>
        </div>
    </div>
    <header class="site-header">
        <div class="header-main">
            <div class="container-xl header-grid">
                <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-label="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="@store" width="48" height="48" />
                    <span>
                        <strong>ABS Silk Saris</strong>
                        <small>Kanchipuram · Since the loom</small>
                    </span>
                </a>
                <form class="header-search d-none d-lg-flex" asp-controller="Shop" asp-action="Index" method="get" role="search">
                    <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Search weaves, colours, SKU…" aria-label="Search sarees" />
                    <button type="submit" aria-label="Search"><i class="bi bi-search"></i></button>
                </form>
                <div class="header-actions">
                    <partial name="_LoginPartial" />
                    <a class="icon-link" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist">
                        <i class="bi bi-heart"></i>
                        <span class="badge-count" id="wish-count">@Cart.WishlistCount</span>
                    </a>
                    <a class="icon-link" asp-controller="Cart" asp-action="Index" aria-label="Cart">
                        <i class="bi bi-bag"></i>
                        <span class="badge-count" id="cart-count">@Cart.CartCount</span>
                    </a>
                </div>
            </div>
        </div>
        <nav class="mega-nav d-none d-lg-block" aria-label="Primary">
            <div class="container-xl">
                <ul class="mega-list">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="has-mega">
                        <a asp-controller="Shop" asp-action="Index">Collections <i class="bi bi-chevron-down"></i></a>
                        <div class="mega-panel">
                            <div class="container-xl mega-grid">
                                <div>
                                    <p class="mega-label">Featured categories</p>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="bridal-silk-sarees">Bridal Silk Sarees</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="wedding-collection">Wedding Collection</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="pure-zari-sarees">Pure Zari Sarees</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="traditional-kanchipuram-sarees">Traditional Kanchipuram</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="soft-silk-sarees">Soft Silk Sarees</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-category="party-wear-silk-sarees">Party Wear Silk</a>
                                </div>
                                <div>
                                    <p class="mega-label">Weaves of Kanjivaram</p>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Temple">Temple Border</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Checks">Kattam Checks</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Korvai">Korvai Contrast</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Ganga">Ganga Jamuna</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Butta">Borderless Butta</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Zari">Pure Zari</a>
                                </div>
                                <div>
                                    <p class="mega-label">Occasions</p>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Bridal">Muhurtham</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Wedding">Wedding rituals</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Festival">Festive days</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Party">Reception &amp; sangeet</a>
                                    <a asp-controller="Shop" asp-action="Index" asp-route-q="Everyday">Everyday classics</a>
                                </div>
                                <a class="mega-feature" asp-controller="Shop" asp-action="Index" asp-route-category="bridal-silk-sarees">
                                    <img src="~/images/categories/category-bridal.png" alt="Bridal collection" width="280" height="360" />
                                    <span>Bridal atelier · Shop now</span>
                                </a>
                            </div>
                        </div>
                    </li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-sort="newest">New Arrivals</a></li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-category="bridal-silk-sarees">Bridal</a></li>
                    <li><a asp-controller="Home" asp-action="About">Heritage</a></li>
                    <li><a asp-controller="Order" asp-action="Track">Track Order</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-start mobile-drawer" tabindex="-1" id="mobileNav">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">ABS Silk Saris</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form asp-controller="Shop" asp-action="Index" method="get" class="mobile-search mb-4">
                <input type="search" name="q" placeholder="Search sarees" />
                <button type="submit"><i class="bi bi-search"></i></button>
            </form>
            <a asp-controller="Shop" asp-action="Index">Shop Collection</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="bridal-silk-sarees">Bridal Silk</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="wedding-collection">Wedding</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="pure-zari-sarees">Pure Zari</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="traditional-kanchipuram-sarees">Traditional</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="soft-silk-sarees">Soft Silk</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="party-wear-silk-sarees">Party Wear</a>
            <a asp-controller="Home" asp-action="About">Heritage</a>
            <a asp-controller="Order" asp-action="Track">Track Order</a>
            <a asp-area="Identity" asp-page="/Account/Login">Login / Register</a>
        </div>
    </div>

    <form id="anti-forgery" class="d-none">@Html.AntiForgeryToken()</form>
    <main id="main">
        @if (TempData["Notice"] is string notice)
        {
            <div class="toast-notice">@notice</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-ornament"></div>
        <div class="container-xl">
            <div class="row g-5">
                <div class="col-lg-4">
                    <a class="brand brand-light" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.svg" alt="" width="42" height="42" />
                        <span>
                            <strong>ABS Silk Saris</strong>
                            <small>Authentic Kanchipuram silk</small>
                        </span>
                    </a>
                    <p class="mt-3 footer-story">A contemporary house for a centuries-old craft. We work with master weavers in Kanchipuram to bring korvai borders, temple motifs and tested zari to celebrations around the world.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Atelier</h6>
                    <a asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-controller="Shop" asp-action="Index">Shop Collection</a>
                    <a asp-controller="Home" asp-action="Contact">Contact</a>
                    <a asp-controller="Order" asp-action="Track">Order Tracking</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Policies</h6>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a>
                    <a asp-controller="Home" asp-action="Shipping">Shipping Policy</a>
                    <a asp-controller="Home" asp-action="Returns">Return Policy</a>
                </div>
                <div class="col-lg-3">
                    <h6>Visit &amp; write</h6>
                    <p>@Config["Store:Address"]</p>
                    <p><a href="tel:@phone">@phone</a><br /><a href="mailto:@email">@email</a></p>
                    <div class="socials">
                        <a href="@Config["Store:Instagram"]" aria-label="Instagram" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a>
                        <a href="@Config["Store:Facebook"]" aria-label="Facebook" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                        <a href="https://wa.me/@wa" aria-label="WhatsApp" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.UtcNow.Year ABS Silk Saris. All weaves reserved.</span>
                <span>Secure checkout · SSL encrypted</span>
            </div>
        </div>
    </footer>

    <a class="whatsapp-fab" href="https://wa.me/@wa?text=Hello%20ABS%20Silk%20Saris%2C%20I%20would%20like%20help%20choosing%20a%20Kanchipuram%20silk." target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="quickViewBody"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
