@model List<AbsSilkSaris.Models.WishlistLine>
<section class="section">
    <div class="container-xl">
        <h1 class="serif" style="color:var(--maroon)">Wishlist</h1>
        @if (!Model.Any())
        {
            <p class="mt-4">Save silks you love for later.</p>
        }
        else
        {
            <div class="product-grid mt-4">
                @foreach (var w in Model)
                {
                    <article class="product-card">
                        <div class="product-media">
                            <img src="@w.ImageUrl" alt="@w.Name" loading="lazy" />
                        </div>
                        <div class="product-body">
                            <h3>@w.Name</h3>
                            <div class="price">₹@w.Price.ToString("N0")</div>
                            <button class="add-full" type="button" data-add-cart="@w.ProductId">Add to cart</button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
